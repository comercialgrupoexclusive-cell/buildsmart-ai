# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# P4.6 Bloco B — vendored Axonometra tem seu próprio build Vite/node_modules;
# só o resultado final (public/axonometra/) é versionado, não este rascunho.
/vendor/axonometra/node_modules
/vendor/axonometra/dist

# PoC OpenPlan3D — mesmo padrão: vendored SvelteKit app tem seu próprio
# node_modules/build; só public/labs/openplan3d/ é versionado.
/vendor/openplan3d/node_modules
/vendor/openplan3d/build
/vendor/openplan3d/.svelte-kit
/vendor/openplan3d/test-results
/vendor/openplan3d/playwright-report
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
dev-server.err.log
.codex/

# env files
.env*.local
# keep .env.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Excalidraw fonts — copied by postinstall script, not needed in git
/public/fonts/

# Generated outputs
/outputs/
